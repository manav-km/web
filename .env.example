# ============================================================================
# .env.example — copy to .env and fill in real values. NEVER commit the real .env.
# "public" values are safe to ship to the browser bundle where noted.
# Everything else is SECRET and must only ever live on the backend server.
# ============================================================================

# ---- Firebase (Authentication) ----
# Public — these ARE meant to go into the frontend's Firebase init config.
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
# Public-ish (identifies which RTDB instance to use; access is still controlled
# by the rules in firebase/database.rules.json + the backend's service account).
# Leave unset until you've enabled Realtime Database — see docs/firebase.md.
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app

# Secret — backend only. From Firebase Console → Project Settings → Service accounts
# → Generate new private key. Store the JSON file path OR its contents, never in git.
FIREBASE_SERVICE_ACCOUNT_JSON=service-account.json

# ---- Supabase (application database + storage) ----
# Public — safe for the backend config (not sent to the browser, but not a secret either)
SUPABASE_URL=https://your-supabase-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Secret — backend only. Bypasses Row Level Security. NEVER send to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ---- Gemini (AI) ---- 
# Secret — backend only.
GEMINI_API_KEY=your_gemini_api_key
# Public-ish (just a model name) but kept here so it's one config surface.
GEMINI_MODEL=gemini-3.1-flash-lite

# ---- GitHub (repository sync) ----
# A personal access token raises your GitHub API rate limit and lets private
# repo metadata be read if needed later. Secret — backend only.
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_ACCOUNTS=manav-km

# ---- Admin ----
# The Firebase UID that gets the `admin: true` custom claim. Used only by the
# one-off script that sets the claim — not read at request time (the claim
# itself, verified from the token, is what the backend trusts).
ADMIN_FIREBASE_UID=your_admin_firebase_uid

# ---- Security ----
SECURITY_RATE_LIMIT_WINDOW_SECONDS=60
SECURITY_RATE_LIMIT_MAX_REQUESTS=20
SECURITY_BLOCK_DURATION_SECONDS=900

# ---- Cron ----
CRON_SECRET=generate_a_long_random_string

# ---- CORS ----
# Public. The exact origin of the deployed frontend (no trailing slash).
FRONTEND_ORIGIN=https://manavkm.web.app

# ---- Cloudflare Turnstile (bot protection on the Connect form) ----
# Secret — backend only. Public site key goes in frontend/js/core/config.js instead.
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_SITE_KEY=your_turnstile_site_key

# ---- HTTPS & IP Privacy ----
# Set to "true" in production to enforce 308 redirect and Strict-Transport-Security
ENFORCE_HTTPS=true
# Secret — used to HMAC-hash IP addresses before storing in rate_limit_blocks
IP_HASH_SALT=your_secret_random_salt_string
# Days before IP addresses in audit_logs and security_events are masked by cron (default: 90)
IP_RETENTION_DAYS=90
